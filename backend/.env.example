# Copy this file to .env inside the backend folder and replace the values with your local settings.
# This file is intended for backend-only runtime configuration.
# Example values for local development.

DATABASE_URL=postgresql+psycopg://job_radar:job_radar_dev@localhost:5432/job_radar

JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

GEMINI_API_KEY=
OPENAI_API_KEY=
TAVILY_API_KEY=
JSEARCH_API_KEY=

# JSON list, in this order: fake, tavily, jsearch
SEARCH_SOURCES='["fake"]'
SEARCH_RESULTS_PER_SOURCE=10
SEARCH_DAILY_LIMIT=10
TAVILY_DOMAINS='["justjoin.it","nofluffjobs.com","pracuj.pl","linkedin.com"]'
JSEARCH_COUNTRY=pl

# AI provider: fake | ollama | openai | gemini (fake needs no model and no key)
AI_PROVIDER=fake
AI_MODEL=qwen2.5:3b
# Empty = the provider's usual address. Ollama: http://localhost:11434/v1
AI_BASE_URL=
AI_TIMEOUT_SECONDS=300
# Fill empty fields of a saved search result from its page (Tavily Extract + AI)
AI_ENRICH_SAVED_RESULTS=true
